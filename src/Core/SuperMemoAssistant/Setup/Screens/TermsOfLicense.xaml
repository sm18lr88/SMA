<setup:SMASetupScreenBase x:Class="SuperMemoAssistant.Setup.Screens.TermsOfLicense"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:setup="clr-namespace:SuperMemoAssistant.Setup"
                          mc:Ignorable="d"
                          DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <TextBox Grid.Row="0"
             FontSize="13"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="True"
             Text="{Binding LicenseText, Mode=OneTime}"
             VerticalScrollBarVisibility="Auto"
             Margin="0 0 0 20" />

    <CheckBox Grid.Row="1"
              Content="I have read and agree to the terms of the SuperMemo Assistant license"
              FontSize="14"
              FontWeight="DemiBold"
              IsChecked="{Binding HasAgreedToTermsOfLicense}" />
  </Grid>
</setup:SMASetupScreenBase>