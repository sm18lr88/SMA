 "obsidian": {
  "files": {
   "MyTheme/theme.css": "/* My Theme */\n.theme-dark {\n  --background-primary: #14161b;\n  --background-secondary: #1b1e25;\n  --text-normal: #dcdfe4;\n  --text-muted: var(--text-normal);\n  --interactive-accent: hsl(210, 60%, 55%);\n  --color-red: rgba(240, 80, 80, 0.9);\n  --icon: url(\"data:image/svg+xml;charset=UTF-8,<svg xmlns='http://www.w3.org/2000/svg'><path d='M0 0'/></svg>\");\n  --text-faint: var(--missing, #808080);\n}\n.theme-light {\n  --background-primary: #fbfbf8;\n  --text-normal: #222;\n  --interactive-accent: color-mix(in srgb, #3355ff 70%, white);\n  --text-selection: rgba(51, 85, 255, 0.2);\n}\n.theme-dark.blue-accent { --interactive-accent: #4d8dff; --background-primary: #101820; }\n.theme-light.blue-accent { --interactive-accent: #2255dd; }\n.theme-dark.is-translucent { --background-primary: rgba(0, 0, 0, 0.5); }\n.theme-dark.red-accent { --interactive-accent: #ff5555; }\n.some-toggle-enable.theme-dark { --background-secondary: #000; }\n@media (min-width: 1px) { .theme-dark { --background-primary: red; } }\nbody { --color-blue: #5588ff; }\n",
   "DarkOnly/theme.css": ".theme-dark { --background-primary: #202020; --text-normal: #eee; }\n.theme-dark.warm { --background-primary: #302018; }\n"
  },
