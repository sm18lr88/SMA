<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast tests for the theme engine. The tests that need the real sm20.exe skip when it is absent. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SuperMemoAssistant.Themes.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Themes\SuperMemoAssistant.Themes\SuperMemoAssistant.Themes.csproj" />
    <!-- Tests only: the patched-exe test checks that SMA's symbol resolver still resolves an exe this engine rebuilt. -->
    <ProjectReference Include="..\..\Core\SuperMemoAssistant.Hooks.Symbols\SuperMemoAssistant.Hooks.Symbols.csproj" />
    <None Include="Golden\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Golden" />
  </ItemGroup>
</Project>
