{
 "css": {
  "rules": [
   {
    "css": "",
    "out": []
   },
   {
    "css": "body { --a: 1; }",
    "out": [
     [
      "body",
      " --a: 1; "
     ]
    ]
   },
   {
    "css": "/* c */ .x { --a: 1; --b: 2 }",
    "out": [
     [
      ".x",
      " --a: 1; --b: 2 "
     ]
    ]
   },
   {
    "css": ".d { --icon: url(\"data:image/svg+xml;charset=UTF-8,<svg a='b'>{x}</svg>\"); --b: 1px solid Canvas; } :root { --c: red }",
    "out": [
     [
      ".d",
      " --icon: url(\"data:image/svg+xml;charset=UTF-8,<svg a='b'>{x}</svg>\"); --b: 1px solid Canvas; "
     ],
     [
      ":root",
      " --c: red "
     ]
    ]
   },
   {
    "css": "@media (x) { .theme-dark { --a: 1 } } .theme-light { --b: 2 }",
    "out": [
     [
      ".theme-light",
      " --b: 2 "
     ]
    ]
   },
   {
    "css": ".a, .b > .c, body.theme-dark.x { --v: var(--w, calc(1px + 2px)); }",
    "out": [
     [
      ".a, .b > .c, body.theme-dark.x",
      " --v: var(--w, calc(1px + 2px)); "
     ]
    ]
   },
   {
    "css": ".esc { --s: 'a\\'b;c'; --t: 1 }",
    "out": [
     [
      ".esc",
      " --s: 'a\\'b;c'; --t: 1 "
     ]
    ]
   },
   {
    "css": ".x { --y: foo(bar;baz); }",
    "out": [
     [
      ".x",
      " --y: foo(bar;baz); "
     ]
    ]
   },
   {
    "css": "body{--a:1}}.z{--b:2}",
    "out": [
     [
      "body",
      "--a:1"
     ],
     [
      "",
      ""
     ],
     [
      ".z",
      "--b:2"
     ]
    ]
   }
  ],
  "custom_properties": [
   {
    "body": " --a: 1; ",
    "out": {
     "--a": "1"
    }
   },
   {
    "body": " --a: 1; --b: 2 ",
    "out": {
     "--a": "1",
     "--b": "2"
    }
   },
   {
    "body": " --icon: url(\"data:image/svg+xml;charset=UTF-8,<svg a='b'>{x}</svg>\"); --b: 1px solid Canvas; ",
    "out": {
     "--icon": "url(\"data:image/svg+xml;charset=UTF-8,<svg a='b'>{x}</svg>\")",
     "--b": "1px solid Canvas"
    }
   },
   {
    "body": " --c: red ",
    "out": {
     "--c": "red"
    }
   },
   {
    "body": " --b: 2 ",
    "out": {
     "--b": "2"
    }
   },
   {
    "body": " --v: var(--w, calc(1px + 2px)); ",
    "out": {
     "--v": "var(--w, calc(1px + 2px))"
    }
   },
   {
    "body": " --s: 'a\\'b;c'; --t: 1 ",
    "out": {
     "--s": "'a\\'b;c'",
     "--t": "1"
    }
   },
   {
    "body": " --y: foo(bar;baz); ",
    "out": {
     "--y": "foo(bar;baz)"
    }
   },
   {
    "body": "--a:1",
    "out": {
     "--a": "1"
    }
   },
   {
    "body": "",
    "out": {}
   },
   {
    "body": "--b:2",
    "out": {
     "--b": "2"
    }
   }
  ],
  "body_classes": [
   {
    "part": "body",
    "out": []
   },
   {
    "part": " body.theme-dark ",
    "out": [
     "theme-dark"
    ]
   },
   {
    "part": ".theme-light.x",
    "out": [
     "theme-light",
     "x"
    ]
   },
   {
    "part": ":root",
    "out": []
   },
   {
    "part": "html.a-b",
    "out": [
     "a-b"
    ]
   },
   {
    "part": "body > div",
    "out": null
   },
   {
    "part": "div.x",
    "out": null
   },
   {
    "part": "",
    "out": null
   },
   {
    "part": "  ",
    "out": null
   },
   {
    "part": "body .x",
    "out": null
   },
   {
    "part": ".a.b.c",
    "out": [
     "a",
     "b",
     "c"
    ]
   },
   {
    "part": "#id",
    "out": null
   },
   {
    "part": "body.x:hover",
    "out": null
   }
  ],
  "split_top": [
   {
    "text": "a, b",
    "out": [
     "a",
     " b"
    ]
   },
   {
    "text": "a(b, c), d",
    "out": [
     "a(b, c)",
     " d"
    ]
   },
   {
    "text": "var(--x, rgb(1, 2, 3)), z",
    "out": [
     "var(--x, rgb(1, 2, 3))",
     " z"
    ]
   },
   {
    "text": "",
    "out": [
     ""
    ]
   },
   {
    "text": "no commas",
    "out": [
     "no commas"
    ]
   },
   {
    "text": "a,,b",
    "out": [
     "a",
     "",
     "b"
    ]
   }
  ],
  "resolve_env": {
   "--a": "#112233",
   "--b": "var(--a)",
   "--c": "var(--missing, var(--a))",
   "--loop": "var(--loop)",
   "--empty": "",
   "--mix": "color-mix(in srgb, var(--a) 50%, white)",
   "--tr": "rgba(0, 0, 0, 0.5)"
  },
  "resolve": [
   {
    "value": "var(--a)",
    "out": "#112233"
   },
   {
    "value": "var(--b)",
    "out": "#112233"
   },
   {
    "value": "var(--c)",
    "out": " #112233"
   },
   {
    "value": "var(--nothing)",
    "out": ""
   },
   {
    "value": "var(--nothing, red)",
    "out": " red"
   },
   {
    "value": "var(--nothing, var(--a), x)",
    "out": " #112233, x"
   },
   {
    "value": "var(--loop)",
    "out": ""
   },
   {
    "value": "var(--empty)",
    "out": ""
   },
   {
    "value": "var(--empty, #fff)",
    "out": ""
   },
   {
    "value": "calc(var(--a) + var(--b))",
    "out": "calc(#112233 + #112233)"
   },
   {
    "value": "var(--mix)",
    "out": "color-mix(in srgb, #112233 50%, white)"
   },
   {
    "value": "plain",
    "out": "plain"
   },
   {
    "value": "var(--a",
    "out": ""
   },
   {
    "value": "var(",
    "out": ""
   },
   {
    "value": "var(--b) var(--a)",
    "out": "#112233 #112233"
   }
  ],
  "jsonc": [
   {
    "text": "{\"a\": 1}",
    "out": {
     "a": 1
    }
   },
   {
    "text": "{\"a\": 1, // c\n \"b\": 2,}",
    "out": {
     "a": 1,
     "b": 2
    }
   },
   {
    "text": "{\"u\": \"http://x/y\", /* c */ \"v\": [1, 2,],}",
    "out": {
     "u": "http://x/y",
     "v": [
      1,
      2
     ]
    }
   },
   {
    "text": "{\"s\": \"a // b /* c */\"}",
    "out": {
     "s": "a // b /* c */"
    }
   },
   {
    "text": "[1, 2, 3,]",
    "out": [
     1,
     2,
     3
    ]
   },
   {
    "text": "{\"a\": }",
    "error": true
   },
   {
    "text": "",
    "error": true
   },
   {
    "text": "// only a comment\n{\"a\": 1}",
    "out": {
     "a": 1
    }
   }
  ]
 },
