<Window x:Class="SuperMemoAssistant.Plugins.Formulation.UI.FindingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formulation advisor"
        Width="560"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top"
               Margin="0,0,0,8"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Text="{Binding Summary}" />
    <Button DockPanel.Dock="Bottom"
            HorizontalAlignment="Right"
            Margin="0,8,0,0"
            Padding="16,2"
            IsCancel="True"
            Content="Close"
            Click="Close_Click" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Findings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8"
                    Padding="8"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="3">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                  <Run Text="{Binding Severity, Mode=OneWay}" />
                  <Run Text="-" />
                  <Run Text="{Binding RuleTitle, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,4" TextWrapping="Wrap" Text="{Binding Message}" />
                <TextBlock TextWrapping="Wrap">
                  <Hyperlink NavigateUri="{Binding Link}" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="{Binding Link, Mode=OneWay}" />
                  </Hyperlink>
                </TextBlock>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
