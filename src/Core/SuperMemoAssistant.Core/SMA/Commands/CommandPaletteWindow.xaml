<Window x:Class="SuperMemoAssistant.SMA.Commands.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMA command palette"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="White"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#6D8764" />
    <SolidColorBrush x:Key="Muted" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Selection" Color="#E3EADF" />
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="{StaticResource Accent}" BorderThickness="1" Background="White">
    <StackPanel>
      <TextBox x:Name="QueryBox"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Command"
               FontSize="16"
               Padding="12 10"
               BorderThickness="0 0 0 1"
               BorderBrush="{StaticResource Accent}" />

      <ListBox x:Name="ResultsList"
               ItemsSource="{Binding Results}"
               SelectedIndex="{Binding SelectedIndex}"
               AutomationProperties.Name="Commands"
               MaxHeight="420"
               BorderThickness="0"
               Focusable="False"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseUp="ResultsList_MouseUp">
        <ListBox.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="12 6" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Command.Title}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                  <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{StaticResource Selection}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Command.Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Command.OwnerName}" FontSize="11" Foreground="{StaticResource Muted}" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding Command.HotKey}"
                         FontSize="12"
                         Foreground="{StaticResource Muted}"
                         VerticalAlignment="Center"
                         Margin="16 0 0 0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyText"
                 Text="No command matches."
                 Foreground="{StaticResource Muted}"
                 Margin="12 10"
                 Visibility="Collapsed" />
    </StackPanel>
  </Border>
</Window>
