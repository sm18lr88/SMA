<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI Automation agent for the end-to-end UI tests. It runs on the hidden test desktop and has no window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SuperMemoAssistant.Tests.UiAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
