<Project Sdk="Microsoft.NET.Sdk">
  <!-- Image occlusion editor (svg-edit). -->
  <PropertyGroup>
    <RootNamespace>SuperMemoAssistant.Plugins.ImageOcclusion</RootNamespace>
    <UseWPF>true</UseWPF>    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fody" PrivateAssets="all" />
    <PackageReference Include="Anotar.Serilog.Fody" PrivateAssets="all" />
    <PackageReference Include="FileSignatures" />
    <PackageReference Include="OpenMcdf" />
    <PackageReference Include="Svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Services\SuperMemoAssistant.Services.Medias.Images\SuperMemoAssistant.Services.Medias.Images.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Interop\src\SuperMemoAssistant.Interop\SuperMemoAssistant.Interop.csproj" />
    <ProjectReference Include="$(RepoRoot)libs\PluginManager\src\PluginManager.Interop\PluginManager.Interop.csproj" />
    <ProjectReference Include="$(RepoRoot)libs\Extensions.System.IO\src\Extensions.System.IO.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="imageocclusioneditor.ico" />
    <Content Include="Resources\Licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="svgedit\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>