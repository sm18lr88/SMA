<Project Sdk="Microsoft.NET.Sdk">
  <!-- Imports web pages, feeds and browser captures into SuperMemo. -->
  <PropertyGroup>
    <RootNamespace>SuperMemoAssistant.Plugins.Import</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fody" PrivateAssets="all" />
    <PackageReference Include="Anotar.Serilog.Fody" PrivateAssets="all" />
    <PackageReference Include="PropertyChanged.Fody" PrivateAssets="all" />
    <PackageReference Include="FastMember" />
    <PackageReference Include="FontAwesome5" />
    <PackageReference Include="Forge.Forms" />
    <PackageReference Include="CodeHollow.FeedReader" />
    <PackageReference Include="Flurl.Http" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="SmartReader" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
    <PackageReference Include="UAParser" />
  </ItemGroup>
  <ItemGroup>
    <!-- The terms window shows the plugin's own LICENSE, so it can never go stale. -->
    <EmbeddedResource Include="$(RepoRoot)src\Plugins\SuperMemoAssistant.Plugins.Import\LICENSE" Link="Resources\LICENSE" LogicalName="SuperMemoAssistant.Plugins.Import.LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Interop\src\SuperMemoAssistant.Interop\SuperMemoAssistant.Interop.csproj" />
    <ProjectReference Include="$(RepoRoot)libs\PluginManager\src\PluginManager.Interop\PluginManager.Interop.csproj" />
    <ProjectReference Include="$(RepoRoot)libs\Extensions.System.IO\src\Extensions.System.IO.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Plugins\SuperMemoAssistant.Plugins.Import\libs\SuperMemoAssistant.Plugins.Import.Interop\SuperMemoAssistant.Plugins.Import.Interop.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Plugins\SuperMemoAssistant.Plugins.Import\libs\SuperMemoAssistant.Plugins.Import.BrowserNativeHost\SuperMemoAssistant.Plugins.Import.BrowserNativeHost.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Services\SuperMemoAssistant.Services.HTML\SuperMemoAssistant.Services.HTML.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Services\SuperMemoAssistant.Services.ToastNotifications\SuperMemoAssistant.Services.ToastNotifications.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Services\SuperMemoAssistant.Services.UI\SuperMemoAssistant.Services.UI.csproj" />
  </ItemGroup>
</Project>