 "vscode": {
  "files": {
   "vs/base.json": "// a base theme with comments and trailing commas\n{\n  \"name\": \"Base Night\",\n  \"type\": \"dark\",\n  /* workbench colors */\n  \"colors\": {\n    \"editor.background\": \"#1f2430\",\n    \"editor.foreground\": \"#cad3f5\",\n    \"sideBar.background\": \"#181c26\",\n    \"input.background\": \"#2a3040\",\n    \"panel.border\": \"#ffffff22\",\n    \"editor.selectionBackground\": \"#3a4a7a88\",\n    \"button.background\": \"#5a7bd8\",\n    \"descriptionForeground\": \"#cad3f5b3\",\n    \"editorLineNumber.foreground\": \"#6e738d\",\n    \"terminal.ansiRed\": \"#ed8796\",\n    \"terminal.ansiGreen\": \"#a6da95\",\n    \"ignored.number\": 5,\n    \"url.like\": \"http://example.test/not-a-comment\",\n  },\n  \"tokenColors\": [\n    { \"scope\": \"keyword\", \"settings\": { \"foreground\": \"#c6a0f6\" } },\n    { \"scope\": \"string\", \"settings\": { \"foreground\": \"#a6da95\" } },\n    { \"scope\": \"number\", \"settings\": { \"foreground\": \"#f5a97f\" } },\n    { \"scope\": \"func\", \"settings\": { \"foreground\": \"#8aadf4\" } },\n    { \"scope\": \"warn\", \"settings\": { \"foreground\": \"#eed49f\" } },\n    { \"scope\": \"info\", \"settings\": { \"foreground\": \"#8bd5ca\" } },\n    { \"scope\": \"gray\", \"settings\": { \"foreground\": \"#808080\" } },\n    { \"scope\": \"nofg\", \"settings\": { \"fontStyle\": \"italic\" } },\n    { \"scope\": \"nosettings\" },\n  ],\n}\n",
   "vs/child.json": "{ \"include\": \"./base.json\", \"name\": \"Child Night\", \"colors\": { \"editor.background\": \"#202020\" }, \"tokenColors\": [ { \"settings\": { \"foreground\": \"#ff3355\" } } ] }",
   "vs/light.json": "{ \"type\": \"light\", \"colors\": { \"editor.background\": \"#fdf6e3\", \"editor.foreground\": \"#586e75\", \"sideBar.background\": \"#eee8d5\", \"panel.border\": \"#00000033\", \"editor.selectionBackground\": \"#07368333\", \"button.background\": \"#268bd2cc\" }, \"tokenColors\": [ { \"settings\": { \"foreground\": \"#dc322f\" } }, { \"settings\": { \"foreground\": \"#859900\" } } ] }",
   "vs/plain.json": "{}",
   "vs/hc.json": "{ \"type\": \"hc-light\", \"colors\": { \"editor.background\": \"#ffffff\" } }",
   "vs/bom.json": "\ufeff{ \"name\": \"Bom Theme\", \"colors\": { \"editor.background\": \"#101820\" } }",
   "vs/broken.json": "{ \"name\": \"Broken\", ",
   "ext/package.json": "{ \"name\": \"my-ext\", \"displayName\": \"%ext.name%\", \"contributes\": { \"themes\": [ { \"label\": \"%theme.a%\", \"uiTheme\": \"vs-dark\", \"path\": \"./themes/a.json\" }, { \"label\": \"%theme.b%\", \"uiTheme\": \"vs\", \"path\": \"./themes/b.json\" }, { \"id\": \"only-id\", \"path\": \"./themes/c.json\" } ] } }",
   "ext/package.nls.json": "{ \"ext.name\": \"My Extension\", \"theme.a\": { \"message\": \"Alpha\" }, \"theme.b\": \"Beta\" }",
   "ext/themes/a.json": "{ \"colors\": { \"editor.background\": \"#101018\" }, \"tokenColors\": [ { \"settings\": { \"foreground\": \"#ff5577\" } } ] }",
   "ext/themes/b.json": "{ \"colors\": { \"editor.background\": \"#f8f8f0\" } }",
   "ext/themes/c.json": "{ \"type\": \"dark\", \"colors\": { \"editor.background\": \"#0a0a0a\" } }"
  },
